rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return true; // request.auth != null; // Allowing all access since prototype uses local dummy auth
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper functions for entity validation
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidProduct(data) {
      return data.keys().hasAll(['code', 'name', 'category', 'unit', 'retailPrice', 'wholesalePrice', 'costPrice', 'stock', 'threshold']) &&
             data.code is string && data.code.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.category is string && data.category.size() <= 64 &&
             data.unit is string && data.unit.size() <= 16 &&
             data.retailPrice is number &&
             data.wholesalePrice is number &&
             data.costPrice is number &&
             data.stock is number &&
             data.threshold is number;
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isSignedIn() && isValidId(productId);
    }
    
    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone', 'isContractor', 'balance']) &&
             data.name is string && data.name.size() <= 128 &&
             data.phone is string && data.phone.size() <= 32 &&
             data.isContractor is bool &&
             data.balance is number;
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isSignedIn() && isValidId(customerId) && isValidCustomer(incoming());
      allow delete: if isSignedIn() && isValidId(customerId);
      
      match /ledger/{ledgerId} {
        allow read: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(ledgerId) && incoming().amount is number;
        allow update: if isSignedIn() && isValidId(ledgerId) && incoming().amount is number;
        allow delete: if isSignedIn() && isValidId(ledgerId);
      }
      
      match /paymentSchedule/{paymentId} {
        allow read: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(paymentId) && incoming().amount is number;
        allow update: if isSignedIn() && isValidId(paymentId) && incoming().amount is number;
        allow delete: if isSignedIn() && isValidId(paymentId);
      }
    }

    function isValidSupplier(data) {
       return data.keys().hasAll(['name', 'phone', 'contactPerson', 'balance']) &&
              data.name is string && data.name.size() <= 128 &&
              data.phone is string && data.phone.size() <= 32 &&
              data.contactPerson is string && data.contactPerson.size() <= 128 &&
              data.balance is number;
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(supplierId) && isValidSupplier(incoming());
      allow update: if isSignedIn() && isValidId(supplierId) && isValidSupplier(incoming());
      allow delete: if isSignedIn() && isValidId(supplierId);
      
      match /ledger/{ledgerId} {
        allow read: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(ledgerId) && incoming().amount is number;
        allow update: if isSignedIn() && isValidId(ledgerId) && incoming().amount is number;
        allow delete: if isSignedIn() && isValidId(ledgerId);
      }
    }
    
    function isValidPurchaseOrder(data) {
      return data.keys().hasAll(['supplierId', 'supplierName', 'date', 'totalAmount', 'status']) &&
             data.supplierId is string && data.supplierId.size() <= 128 &&
             data.supplierName is string && data.supplierName.size() <= 128 &&
             data.date is string && data.date.size() <= 64 &&
             data.totalAmount is number &&
             data.status is string && data.status.size() <= 32 &&
             (data.status == 'draft' || data.status == 'ordered' || data.status == 'received') &&
             data.items is list && data.items.size() <= 50;
    }

    match /purchaseOrders/{poId} {
        allow read: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(poId) && isValidPurchaseOrder(incoming());
        allow update: if isSignedIn() && isValidId(poId) && isValidPurchaseOrder(incoming());
        allow delete: if isSignedIn() && isValidId(poId);
        
        match /paymentSchedule/{paymentId} {
            allow read: if isSignedIn();
            allow list: if isSignedIn();
            allow create: if isSignedIn() && isValidId(paymentId) && incoming().amount is number;
            allow update: if isSignedIn() && isValidId(paymentId) && incoming().amount is number;
            allow delete: if isSignedIn() && isValidId(paymentId);
        }
    }

    function isValidSaleRecord(data) {
       return data.keys().hasAll(['date', 'totalAmount', 'totalCost', 'profit', 'customerName', 'paymentMethod']) &&
              data.date is string && data.date.size() <= 64 &&
              data.totalAmount is number &&
              data.totalCost is number &&
              data.profit is number &&
              data.customerName is string && data.customerName.size() <= 128 &&
              data.paymentMethod is string && data.paymentMethod.size() <= 32 &&
              data.items is list && data.items.size() <= 100;
    }

    match /sales/{saleId} {
       allow read: if isSignedIn();
       allow list: if isSignedIn();
       allow create: if isSignedIn() && isValidId(saleId) && isValidSaleRecord(incoming());
       allow update: if isSignedIn() && isValidId(saleId) && isValidSaleRecord(incoming());
       allow delete: if isSignedIn() && isValidId(saleId);
    }
    
    function isValidExpense(data) {
      return data.keys().hasAll(['type', 'description', 'amount', 'date']) &&
             data.type is string && data.type.size() <= 32 &&
             data.description is string && data.description.size() <= 256 &&
             data.amount is number &&
             data.date is string && data.date.size() <= 64;
    }

    match /expenses/{expenseId} {
       allow read: if isSignedIn();
       allow list: if isSignedIn();
       allow create: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming());
       allow update: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming());
       allow delete: if isSignedIn() && isValidId(expenseId);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['timestamp', 'username', 'role', 'actionType', 'details']) &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.username is string && data.username.size() <= 128 &&
             data.role is string && data.role.size() <= 32 &&
             data.actionType is string && data.actionType.size() <= 64 &&
             data.details is string && data.details.size() <= 512;
    }

    match /auditLogs/{logId} {
       allow read: if isSignedIn();
       allow list: if isSignedIn();
       allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
       allow update: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
       allow delete: if isSignedIn() && isValidId(logId);
    }
  }
}
