{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Inventory product definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Auto-generated document ID" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string", "enum": ["pc", "kg", "ft", "box"] },
        "retailPrice": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "number" },
        "threshold": { "type": "number" },
        "location": { "type": "string" }
      },
      "required": ["code", "name", "category", "unit", "retailPrice", "wholesalePrice", "costPrice", "stock", "threshold"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Retail or wholesale customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "isContractor": { "type": "boolean" },
        "balance": { "type": "number" }
      },
      "required": ["name", "phone", "isContractor", "balance"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Entry in the customer ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["purchase", "payment"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "balanceAfter": { "type": "number" }
      },
      "required": ["date", "type", "amount", "description", "balanceAfter"]
    },
    "PaymentSchedule": {
      "title": "PaymentSchedule",
      "description": "Payment schedule for a customer or PO",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dueDate": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid"] },
        "note": { "type": "string" }
      },
      "required": ["dueDate", "amount", "status"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Inventory supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "contactPerson": { "type": "string" },
        "balance": { "type": "number" }
      },
      "required": ["name", "phone", "contactPerson", "balance"]
    },
    "SupplierLedgerEntry": {
      "title": "SupplierLedgerEntry",
      "description": "Entry in the supplier ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["purchase_order", "payment"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "balanceAfter": { "type": "number" }
      },
      "required": ["date", "type", "amount", "description", "balanceAfter"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Purchase order from a supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "date": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "ordered", "received"] },
        "paidAmount": { "type": "number" },
        "items": { "type": "array" }
      },
      "required": ["supplierId", "supplierName", "date", "totalAmount", "status"]
    },
    "SaleRecord": {
      "title": "SaleRecord",
      "description": "Record of a sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "totalAmount": { "type": "number" },
        "totalCost": { "type": "number" },
        "profit": { "type": "number" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "khata"] },
        "items": { "type": "array" }
      },
      "required": ["date", "totalAmount", "totalCost", "profit", "customerName", "paymentMethod"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Shop expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["shop", "transport"] },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["type", "description", "amount", "date"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit log for tracking actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "cashier"] },
        "actionType": { "type": "string" },
        "details": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["timestamp", "username", "role", "actionType", "details", "uid"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Inventory products"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "Customer" },
      "description": "Customers"
    },
    "/customers/{customerId}/ledger/{ledgerId}": {
      "schema": { "$ref": "LedgerEntry" },
      "description": "Customer ledger"
    },
    "/customers/{customerId}/paymentSchedule/{paymentId}": {
      "schema": { "$ref": "PaymentSchedule" },
      "description": "Customer payment schedules"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "Supplier" },
      "description": "Suppliers"
    },
    "/suppliers/{supplierId}/ledger/{ledgerId}": {
      "schema": { "$ref": "SupplierLedgerEntry" },
      "description": "Supplier ledger"
    },
    "/purchaseOrders/{poId}": {
      "schema": { "$ref": "PurchaseOrder" },
      "description": "Purchase Orders"
    },
    "/purchaseOrders/{poId}/paymentSchedule/{paymentId}": {
      "schema": { "$ref": "PaymentSchedule" },
      "description": "Purchase order payment schedules"
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "SaleRecord" },
      "description": "Sales records"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "Expense" },
      "description": "Store expenses"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Audit logs for actions"
    }
  }
}
